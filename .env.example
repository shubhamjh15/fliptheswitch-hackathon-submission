# Switch agent bridge (Switch Console's local server is usually http://localhost:8000;
# from inside Docker use http://host.docker.internal:8000)
SWITCH_URL=http://localhost:8000
# AGENT_REGISTRATION_TOKEN from your Switch server's .env / Console settings
SWITCH_REGISTRATION_TOKEN=
# Optional: pin the war room; otherwise SNITCH picks the room whose name contains "snitch"
SNITCH_ROOM_ID=

# The service SNITCH guards (needs /health, /deploys, /logs, POST /deploy)
SNITCH_SERVICE_URL=http://localhost:9000
SNITCH_SERVICE_NAME=checkout-service
SNITCH_ERROR_THRESHOLD=0.25
SNITCH_POLL_SECONDS=3
# Comma-separated chat names allowed to approve rollbacks (empty = anyone in the room)
SNITCH_APPROVERS=

# Optional: Claude writes the verdicts and postmortems. Without it, templates are used.
ANTHROPIC_API_KEY=
SNITCH_MODEL=claude-sonnet-5-5
